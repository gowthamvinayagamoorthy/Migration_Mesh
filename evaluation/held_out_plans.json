    "expected_verdict": "SAFE",
    "plan_data": {
      "resource_changes": [
        {
          "address": "aws_rds_cluster.aurora_postgres",
          "type": "aws_rds_cluster",
          "change": {
            "actions": ["update"],
            "before": { "tags": { "Env": "staging" } },
            "after": { "tags": { "Env": "production" } }
          }
        }
      ]
    }
  },
