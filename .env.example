# MigrationMesh Environment Variables
# Copy this file to .env and configure your environment variables.

# Mandatory HMAC Cryptographic Ledger Secret Key
# Used for HMAC-SHA256 signing of each append-only audit ledger block
MIGRATIONMESH_HMAC_KEY=change_me_to_a_secure_random_hmac_key_2026

# Privacy & Token Vault Salt
# Used for deterministic anonymization hashing
MIGRATIONMESH_VAULT_SALT=migrationmesh-vault-salt-2026

# Local / Remote LLM Inference Configuration
# MigrationMesh supports Ollama local models or OpenAI/Anthropic APIs
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Optional Cloud API Keys (for real cloud deployment pipelines only - reasoning plane NEVER holds credentials)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AZURE_SUBSCRIPTION_ID=
# GOOGLE_APPLICATION_CREDENTIALS=
